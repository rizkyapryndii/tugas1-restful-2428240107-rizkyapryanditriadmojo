      "script": {
        "exec": [
          "pm.test(\"Status code harus 200\", function () {\r",
          "    pm.response.to.have.status(200);\r",
          "});\r",
          "\r",
          "pm.test(\"Respons berupa array dokter\", function () {\r",
          "    const data = pm.response.json();\r",
          "\r",
          "    pm.expect(data).to.be.an(\"array\");\r",
          "\r",
          "    if (data.length > 0) {\r",
          "        pm.expect(data[0]).to.have.property(\"id\");\r",
          "        pm.expect(data[0]).to.have.property(\"nama\");\r",
          "        pm.expect(data[0]).to.have.property(\"spesialis\");\r",
          "        pm.expect(data[0]).to.have.property(\"noStr\");\r",
          "        pm.expect(data[0]).to.have.property(\"jadwalPraktik\");\r",
          "        pm.expect(data[0]).to.have.property(\"biayaKonsultasi\");\r",
          "    }\r",
          "});"
        ],
